# Normalize text files using automatic text detection.
* text=auto

# Preserve existing LFS rules; review incoming-source requirements before import.
*.zap17 filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.zal17 filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
