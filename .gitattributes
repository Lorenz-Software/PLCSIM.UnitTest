# Normalize text files using automatic text detection.
* text=auto
*.sh text eol=lf

# Keep contract source checksums stable across checkouts.
src/PLCSIM.UnitTest.Common/**/*.cs text eol=lf
src/PLCSIM.UnitTest.Common.Application/**/*.cs text eol=lf
access-profiles/siemens/src/PLCSIM.UnitTest.AccessProfiles.Siemens.Contracts/**/*.cs text eol=lf

# Store binary resources directly in Git without text conversion or merging.
*.zap17 binary
*.dll binary
*.pdb binary
*.zal17 binary
*.ico binary
*.png binary
