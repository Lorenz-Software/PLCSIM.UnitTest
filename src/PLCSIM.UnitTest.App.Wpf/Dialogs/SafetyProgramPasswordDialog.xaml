<Window x:Class="PLCSIM.UnitTest.App.Wpf.Dialogs.SafetyProgramPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Safety Program Authorization"
        Width="430"
        MinWidth="430"
        SizeToContent="Height"
        Icon="../Assets/PLCSIM.UnitTest.ico"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="11">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Safety program password"
                   FontSize="15"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Margin="0,5,0,0"
                   Foreground="#5E6B7D"
                   Text="{Binding ProjectTargetDisplayName, StringFormat=PLC target: {0}}"
                   TextTrimming="CharacterEllipsis" />
        <PasswordBox x:Name="PasswordInput"
                     Grid.Row="2"
                     Height="27"
                     Margin="0,14,0,0"
                     VerticalContentAlignment="Center"
                     automation:AutomationProperties.Name="Safety program password"
                     KeyDown="PasswordInput_KeyDown" />

        <StackPanel Grid.Row="4"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="82"
                    Height="24"
                    Margin="0,0,8,0"
                    VerticalContentAlignment="Center"
                    IsDefault="True"
                    Click="Authorize_Click"
                    Content="OK" />
            <Button Width="82"
                    Height="24"
                    VerticalContentAlignment="Center"
                    IsCancel="True"
                    Content="Cancel" />
        </StackPanel>
    </Grid>
</Window>
