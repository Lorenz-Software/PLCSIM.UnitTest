<Window x:Class="PLCSIM.UnitTest.App.Wpf.EvidenceAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidence Analysis"
        Width="1100"
        Height="760"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F3F4F6"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <Style x:Key="AnalysisActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#B8C0CC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ReportActionButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="AssessmentBadge" TargetType="Border">
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#C9D1DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AnalysisAssessment}" Value="Healthy">
                    <Setter Property="Background" Value="#E2F3E7" />
                    <Setter Property="BorderBrush" Value="#77A884" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AnalysisAssessment}" Value="Warning">
                    <Setter Property="Background" Value="#FFF3CD" />
                    <Setter Property="BorderBrush" Value="#C89C3C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AnalysisAssessment}" Value="Error">
                    <Setter Property="Background" Value="#FBE4E4" />
                    <Setter Property="BorderBrush" Value="#C66A6A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10,7"
                Background="#EEF1F5"
                BorderBrush="#B8C0CC"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource AnalysisActionButton}"
                            Content="Run"
                            Command="{Binding AnalyzeCurrentRunCommand}"
                            ToolTip="Analyze the current or latest UnitTest RunEpoch" />
                    <Button Style="{StaticResource AnalysisActionButton}"
                            MinWidth="132"
                            Content="PLC Lifecycle"
                            Command="{Binding AnalyzeLifecycleCommand}"
                            ToolTip="Analyze the latest correlated PLC lifecycle observation" />
                    <Button Style="{StaticResource AnalysisActionButton}"
                            MinWidth="164"
                            Content="Communication Health"
                            Command="{Binding AnalyzeCommunicationSessionCommand}"
                            ToolTip="Analyze communication health for the retained application session" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border Width="1" Height="20" Margin="6,4,10,4" Background="#B8C0CC" />
                    <Button Style="{StaticResource ReportActionButton}"
                            Content="&#xE8C8;"
                            Click="CopyAnalysisReport_Click"
                            IsEnabled="{Binding CanCopyAnalysisReport}"
                            ToolTip="Copy analysis summary" />
                    <Button Style="{StaticResource ReportActionButton}"
                            Content="&#xE74E;"
                            Command="{Binding ExportAnalysisCommand}"
                            ToolTip="Export analysis package" />
                    <Button Style="{StaticResource ReportActionButton}"
                            Content="&#xE74D;"
                            Command="{Binding ClearAnalysisCommand}"
                            ToolTip="Clear analysis and a completed activity trace" />
                    <Menu Height="28" Background="Transparent">
                        <MenuItem Width="30"
                                  Height="28"
                                  Padding="7,3"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="14"
                                  Header="&#xE712;"
                                  ToolTip="More analysis actions">
                            <MenuItem Header="Open Access Profile Log"
                                      FontFamily="Segoe UI"
                                      FontSize="12"
                                      Command="{Binding OpenAccessProfileLogCommand}" />
                            <MenuItem Header="Open Log Folder"
                                      FontFamily="Segoe UI"
                                      FontSize="12"
                                      Command="{Binding OpenLogFolderCommand}" />
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Padding="14,10"
                Background="#FFFFFF"
                BorderBrush="#D5DAE2"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Text="{Binding AnalysisTitle}" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="#4B5563"
                               Text="{Binding AnalysisFocus}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <TextBlock Foreground="#6B7280" Text="Generated " />
                        <TextBlock Foreground="#374151" Text="{Binding AnalysisGeneratedAt}" />
                        <TextBlock Margin="12,0,0,0" Foreground="#6B7280" Text="Activities " />
                        <TextBlock Foreground="#374151" Text="{Binding AnalysisActivityRange}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Style="{StaticResource AssessmentBadge}">
                        <TextBlock FontWeight="SemiBold" Text="{Binding AnalysisAssessment}" />
                    </Border>
                    <Border Padding="7,2"
                            Margin="6,0,0,0"
                            Background="#F5F7FA"
                            BorderBrush="#C9D1DC"
                            BorderThickness="1"
                            CornerRadius="2">
                        <TextBlock Text="{Binding AnalysisCompleteness}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBox x:Name="AnalysisReportTextBox"
                 Grid.Row="2"
                 Text="{Binding AnalysisReport, Mode=OneWay}"
                 IsReadOnly="True"
                 FontFamily="Cascadia Mono, Consolas, Courier New"
                 FontSize="10"
                 BorderThickness="0"
                 Padding="12"
                 Background="#FFFFFF"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextChanged="AnalysisReportTextBox_TextChanged">
            <TextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy Report"
                              Click="CopyAnalysisReport_Click"
                              IsEnabled="{Binding PlacementTarget.DataContext.CanCopyAnalysisReport, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                    <MenuItem Header="Export Package..."
                              Command="{Binding PlacementTarget.DataContext.ExportAnalysisCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                    <Separator />
                    <MenuItem Header="Open Access Profile Log"
                              Command="{Binding PlacementTarget.DataContext.OpenAccessProfileLogCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                    <MenuItem Header="Open Log Folder"
                              Command="{Binding PlacementTarget.DataContext.OpenLogFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                    <Separator />
                    <MenuItem Header="Clear Analysis"
                              Command="{Binding PlacementTarget.DataContext.ClearAnalysisCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                </ContextMenu>
            </TextBox.ContextMenu>
        </TextBox>

        <Border Grid.Row="3"
                Padding="10,0"
                Background="#EEF1F5"
                BorderBrush="#B8C0CC"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#374151"
                           FontWeight="SemiBold"
                           Text="{Binding AnalysisFreshnessStatus}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="#4B5563"
                           Text="{Binding AnalysisRefreshStatus}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
