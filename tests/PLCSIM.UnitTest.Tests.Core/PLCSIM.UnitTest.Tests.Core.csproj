<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <Reference Include="PLCSIM.UnitTest.Common">
      <HintPath>$(ContractArtifactsDir)PLCSIM.UnitTest.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PLCSIM.UnitTest.Common.Application">
      <HintPath>$(ContractArtifactsDir)PLCSIM.UnitTest.Common.Application.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <ProjectReference Include="..\..\src\PLCSIM.UnitTest.Core\PLCSIM.UnitTest.Core.csproj" />
    <ProjectReference Include="..\..\access-profiles\fake\src\PLCSIM.UnitTest.AccessProfiles.Fake\PLCSIM.UnitTest.AccessProfiles.Fake.csproj" />
    <ProjectReference Include="..\PLCSIM.UnitTest.Testing\PLCSIM.UnitTest.Testing.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <Target Name="StageFakeAccessProfileConformancePackage" AfterTargets="Build">
    <PropertyGroup>
      <_FakeConformancePackageDir>$(OutDir)conformance-profiles\fake\</_FakeConformancePackageDir>
      <_FakeProfileProjectDir>$(RepoRoot)access-profiles\fake\src\PLCSIM.UnitTest.AccessProfiles.Fake\</_FakeProfileProjectDir>
    </PropertyGroup>
    <MakeDir Directories="$(_FakeConformancePackageDir)" />
    <MakeDir Directories="$(_FakeConformancePackageDir)docs" />
    <Copy
      SourceFiles="$(OutDir)PLCSIM.UnitTest.AccessProfiles.Fake.dll"
      DestinationFolder="$(_FakeConformancePackageDir)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="$(_FakeProfileProjectDir)manifest.json"
      DestinationFolder="$(_FakeConformancePackageDir)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="$(RepoRoot)access-profiles\fake\docs\configuration.md"
      DestinationFolder="$(_FakeConformancePackageDir)docs"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
