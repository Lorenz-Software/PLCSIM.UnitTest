<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="unit\**\*.cs" />
    <None Remove="unit\**\*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <ProjectReference Include="..\..\..\tests\PLCSIM.UnitTest.Testing\PLCSIM.UnitTest.Testing.csproj" />
    <ProjectReference Include="..\src\PLCSIM.UnitTest.AccessProfiles.Beckhoff\PLCSIM.UnitTest.AccessProfiles.Beckhoff.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" ExcludeAssets="all" />
    <Reference Include="PLCSIM.UnitTest.Common">
      <HintPath>$(ContractArtifactsDir)PLCSIM.UnitTest.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PLCSIM.UnitTest.Common.Application">
      <HintPath>$(ContractArtifactsDir)PLCSIM.UnitTest.Common.Application.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="StageBeckhoffPackage" AfterTargets="Build">
    <ItemGroup>
      <ProfileFiles Include="$(MSBuildThisFileDirectory)..\src\PLCSIM.UnitTest.AccessProfiles.Beckhoff\bin\$(Configuration)\net8.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ProfileFiles)" DestinationFiles="@(ProfileFiles->'$(TargetDir)profiles\beckhoff-tc3-4026\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
