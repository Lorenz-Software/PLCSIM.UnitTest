<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>2.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PLCSIM.UnitTest.Tests.AccessProfiles.Siemens.TiaOpenness.V20" />
  </ItemGroup>
  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="PLCSIM.UnitTest.AccessProfiles.Siemens.Contracts">
      <HintPath>$(ContractArtifactsDir)PLCSIM.UnitTest.AccessProfiles.Siemens.Contracts.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PLCSIM.UnitTest.Common">
      <HintPath>$(ContractArtifactsDir)PLCSIM.UnitTest.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <TiaOpennessV20WorkerProject>$(MSBuildProjectDirectory)\..\..\worker\PLCSIM.UnitTest.AccessProfiles.Siemens.TiaOpenness.V20.Worker\PLCSIM.UnitTest.AccessProfiles.Siemens.TiaOpenness.V20.Worker.csproj</TiaOpennessV20WorkerProject>
  </PropertyGroup>
  <Target Name="CopyTiaOpennessV20Worker" AfterTargets="Build">
    <MSBuild Projects="$(TiaOpennessV20WorkerProject)" Targets="Build" Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <TiaOpennessV20WorkerOutput Include="$(MSBuildProjectDirectory)\..\..\worker\PLCSIM.UnitTest.AccessProfiles.Siemens.TiaOpenness.V20.Worker\bin\$(Configuration)\net48\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(TiaOpennessV20WorkerOutput)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
