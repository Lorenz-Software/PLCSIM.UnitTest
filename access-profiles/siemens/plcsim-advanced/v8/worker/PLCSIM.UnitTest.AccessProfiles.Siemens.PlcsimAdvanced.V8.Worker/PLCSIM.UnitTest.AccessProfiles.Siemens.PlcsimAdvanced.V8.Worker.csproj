<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Version>2.0.1</Version>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PLCSIM.UnitTest.AccessProfiles.Siemens.PlcsimAdvanced.V8.Worker</AssemblyName>
    <RootNamespace>PLCSIM.UnitTest.AccessProfiles.Siemens.PlcsimAdvanced.V8.Worker</RootNamespace>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PLCSIM.UnitTest.Common">
      <HintPath>$(ContractArtifactsDir)PLCSIM.UnitTest.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PLCSIM.UnitTest.AccessProfiles.Siemens.Contracts">
      <HintPath>$(ContractArtifactsDir)PLCSIM.UnitTest.AccessProfiles.Siemens.Contracts.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\shared\EventBufferPollingSnapshotClassifier.cs" Link="Shared\EventBufferPollingSnapshotClassifier.cs" />
    <Compile Include="..\shared\WorkerLogging.cs" Link="Shared\WorkerLogging.cs" />
    <Compile Include="..\shared\WorkerProtocol.cs" Link="Shared\WorkerProtocol.cs" />
  </ItemGroup>
</Project>
